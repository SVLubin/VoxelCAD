; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VoxelCAD"
run/main_scene="res://scenes/editor/EditorRoot.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

BeckettRuntime="*res://addons/beckett/runtime/mcp_runtime.gd"

[beckett]

effort_schema=2
dock_revealed=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="VoxelCAD"

[editor_plugins]

enabled=PackedStringArray("res://addons/beckett/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

common/show_focus_state_on_pointer_event="2"

[input]

